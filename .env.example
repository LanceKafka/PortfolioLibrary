# Copy to ".env" (same folder) — or, better, to ../developer-library-private/.env (outside the web root).
# NEVER commit the real file.

APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
# Long random string; used to hash visitor IPs and sign form tokens.  Generate:  php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
# Only needed when the site is not at the web root and auto-detection is wrong, e.g. /developer-library
APP_BASE=
# Set true only if you run behind a trusted reverse proxy / Cloudflare
TRUST_PROXY=false

# --- database (XAMPP defaults; create a dedicated user for production) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=developer_library
DB_USER=root
DB_PASS=

# --- Email delivery -----------------------------------------------------------
# Preferred: use a Formspree form endpoint (no local SMTP setup needed).
# Example: https://formspree.io/f/your-form-id
FORMSPREE_ENDPOINT=https://formspree.io/f/mljjygwq

# SMTP fallback (PHPMailer):
# Gmail:   host smtp.gmail.com · port 587 · encryption tls · username = full Gmail address
#          password = a 16-character *App Password* (Google Account → Security → 2-Step Verification → App passwords)
MAIL_HOST=geslanilanceericson.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls          # tls = STARTTLS (587) · ssl = implicit TLS (465)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=           # most providers require this to equal MAIL_USERNAME
MAIL_FROM_NAME="The Developer's Library"
# Fallback recipient if none is set in Admin → Settings
MAIL_TO_ADDRESS=
# Leave true. Set false ONLY for a local test SMTP server with a self-signed certificate.
MAIL_VERIFY_PEER=true
